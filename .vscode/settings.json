{
  "editor.formatOnSave": true,
  "cSpell.ignoreRegExpList": ["/[\\u0E00-\\u0E7F]/g"],
  "css.lint.unknownAtRules": "ignore",
  "files.associations": {
    ".env": "env",
    ".env.*": "env"
  },
  "cSpell.words": [
    "akar",
    "hugeicons",
    "iconify",
    "lucide",
    "nprogress",
    "reduxjs",
    "tailwindcss",
    "tanstack",
    "shadcn",
    "tolgee"
  ],
  "i18n-ally.localesPaths": ["langs"],
  "i18n-ally.keystyle": "flat",
  "i18n-ally.annotations": false,
  "i18n-ally.pathMatcher": "{namespace}/{locale}.json"
}
