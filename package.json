{
  "name": "satang-budsai-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm icons:generate",
    "dev": "next dev -p 3031",
    "prebuild": "pnpm icons:check",
    "build": "next build",
    "start": "next start -p 3031",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test",
    "ui:add": "node --experimental-strip-types scripts/shadcn/add-with-iconify.mts",
    "ui:check-icons": "node --experimental-strip-types scripts/shadcn/add-with-iconify.mts --check",
    "icons:generate": "node --experimental-strip-types scripts/icons/generate-offline-icons.mts --write",
    "icons:check": "node --experimental-strip-types scripts/icons/generate-offline-icons.mts",
    "generate": "node src/api/generated/configs/pre-processor.mjs && swagger-typescript-api generate -p ./src/api/generated/configs/swagger-processed.json -o ./src/api/generated/main-service -n apiGenerated.ts --axios --unwrap-response-data && node src/api/generated/configs/post-processor.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:extract": "tolgee extract check",
    "i18n:pull:remote": "tolgee pull",
    "i18n:pull": "node --env-file-if-exists=.env.local --run i18n:pull:remote",
    "i18n:push:remote": "tolgee push",
    "i18n:push": "node --env-file-if-exists=.env.local --run i18n:push:remote"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@iconify/react": "6.0.2",
    "@reduxjs/toolkit": "2.12.0",
    "@tanstack/react-query": "5.102.8",
    "@tolgee/format-icu": "7.2.1",
    "@tolgee/react": "7.2.1",
    "@tolgee/web": "7.2.1",
    "axios": "1.21.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "date-fns": "4.4.0",
    "motion": "13.2.0",
    "next": "16.4.5",
    "next-intl": "4.14.3",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.88.0",
    "react-redux": "9.3.0",
    "sonner": "2.0.7",
    "tw-animate-css": "1.4.0",
    "js-cookie": "3.0.5",
    "nprogress": "0.2.0",
    "socket.io-client": "4.7.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.131",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tolgee/cli": "2.20.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "swagger-typescript-api": "13.12.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "@iconify-json/pixelarticons": "1.2.10",
    "@types/js-cookie": "3.0.6",
    "@types/nprogress": "0.2.3"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "next-themes@0.4.6": "patches/next-themes@0.4.6.patch"
    }
  }
}
